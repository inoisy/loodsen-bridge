#!/usr/bin/python3 -I
"""Шлюз Time на сервере: только чтение и кэш на случай, когда Мак спит.

Клиенты (сервис ресурсного планирования, агенты) ходят без учётки:
    http://127.0.0.1:18481/<путь Time>   (из контейнера — 192.168.200.1:18481)
Шлюз идёт в мост с Мака (TIME_UPSTREAM, по умолчанию http://127.0.0.1:18447 → time-gw-mac, который
сам берёт токен Time; пароль не покидает Мак). Белый список — тот же, что у time-gw-mac;
/core/logs — списания из core Time (все сотрудники, постранично), его Мак ведёт во внутреннюю сеть.
Успешный ответ кэшируется (sqlite, ключ — метод + путь + тело); мост лёг — последний ответ на тот же
запрос с X-Time-Gw-Stale: <когда получен>, кэша нет — 503 TIME_UNAVAILABLE. Журнал — journalctl -u time-gw.
"""
import hashlib, json, os, re, sqlite3, sys, threading, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

UPSTREAM = os.environ.get('TIME_UPSTREAM', 'http://127.0.0.1:18447').rstrip('/')
CACHE = Path(os.environ.get('TIME_GW_CACHE', '/var/lib/time-gw/cache.sqlite'))
LISTEN = os.environ.get('TIME_GW_LISTEN', '127.0.0.1:18481,192.168.200.1:18481')
TIMEOUT = float(os.environ.get('TIME_GW_TIMEOUT', '70'))
ALLOW = [('POST', re.compile(r'^/bff/timesheet$')),
         ('GET', re.compile(r'^/bff/timesheet/filter/[A-Za-z0-9_/-]+$')),
         ('GET', re.compile(r'^/bff/timesheet/column$')),
         ('GET', re.compile(r'^/bff/scope$')),
         ('GET', re.compile(r'^/bff/v3/api-docs$')),
         ('GET', re.compile(r'^/legacy/api/me/?$')),
         ('GET', re.compile(r'^/core/logs$'))]


def allowed(method, path):
    p = urllib.parse.urlsplit(path).path
    return '..' not in p and any(m == method and rx.match(p) for m, rx in ALLOW)


class Cache:
    def __init__(self, path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.db, self.lock = sqlite3.connect(str(path), check_same_thread=False), threading.Lock()
        self.db.execute('create table if not exists r (k text primary key, at text, status int, body blob)')

    def put(self, k, status, body):
        with self.lock:
            self.db.execute('insert or replace into r values (?,?,?,?)',
                            (k, datetime.now(timezone.utc).isoformat(timespec='seconds'), status, body)); self.db.commit()

    def get(self, k):
        with self.lock: return self.db.execute('select at, status, body from r where k=?', (k,)).fetchone()


class Gateway:
    def __init__(self, cache=None, opener=None):
        self.cache = cache or Cache(CACHE)
        self.opener = opener or urllib.request.build_opener()

    def handle(self, method, path, body, ctype):
        """→ (status, headers, body, source)."""
        if not allowed(method, path):
            return 403, {}, b'{"error":"READ_ONLY"}', 'denied'
        k = hashlib.sha256(f'{method} {path}'.encode() + b'\0' + (body or b'')).hexdigest()
        req = urllib.request.Request(UPSTREAM + path, data=body if method == 'POST' else None, method=method,
                                     headers={'Content-Type': ctype or 'application/json'})
        try:
            with self.opener.open(req, timeout=TIMEOUT) as r:
                data, status = r.read(), r.status
        except urllib.error.HTTPError as e:
            data, status = e.read(), e.code
            if status < 500: return status, {}, data, 'upstream'  # ответ Time — клиенту как есть, без кэша
        except (urllib.error.URLError, OSError, TimeoutError):
            data, status = b'', 0
        if status == 200:
            self.cache.put(k, status, data)
            return 200, {}, data, 'upstream'
        hit = self.cache.get(k)
        if hit: return hit[1], {'X-Time-Gw-Stale': hit[0]}, hit[2], 'stale'
        return 503, {}, json.dumps({'error': 'TIME_UNAVAILABLE', 'error_description':
                                    'Time или мост с Мака недоступны, кэша для этого запроса нет'}, ensure_ascii=False).encode(), 'error'


def make_handler(gw):
    class H(BaseHTTPRequestHandler):
        server_version = 'time-gw'

        def _go(self, method):
            t = time.monotonic()
            if self.path == '/health':
                self.send_response(200); self.send_header('Content-Length', '2'); self.end_headers(); self.wfile.write(b'ok'); return
            n = int(self.headers.get('Content-Length') or 0)
            status, headers, data, source = gw.handle(method, self.path, self.rfile.read(n) if n else b'', self.headers.get('Content-Type', ''))
            self.send_response(status); self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('X-Time-Gw-Source', source)
            for k, v in headers.items(): self.send_header(k, v)
            self.send_header('Content-Length', str(len(data))); self.end_headers(); self.wfile.write(data)
            print(f'{self.client_address[0]} {method} {urllib.parse.urlsplit(self.path).path} {status} {source} {int((time.monotonic() - t) * 1000)}ms', flush=True)

        def do_GET(self): self._go('GET')
        def do_POST(self): self._go('POST')
        def log_message(self, *a): pass
    return H


def main():
    gw, servers = Gateway(), []
    for addr in LISTEN.split(','):
        host, port = addr.rsplit(':', 1)
        try: servers.append(ThreadingHTTPServer((host, int(port)), make_handler(gw)))
        except OSError as e: print(f'не слушаю {addr}: {e}', file=sys.stderr, flush=True)
    if not servers: sys.exit('ни одного адреса')
    for s in servers[1:]: threading.Thread(target=s.serve_forever, daemon=True).start()
    print(f'time-gw: {", ".join(f"{s.server_address[0]}:{s.server_address[1]}" for s in servers)} → {UPSTREAM}', flush=True)
    servers[0].serve_forever()


if __name__ == '__main__': main()
