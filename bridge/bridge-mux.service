[Unit]
Description=Мосты в рабочую сеть от нескольких сотрудников: соединение — первому живому слоту
After=network-online.target docker.service
Wants=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/local/bin/bridge-mux serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
